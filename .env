# Backend Environment Variables
# -------------------------------

# The port the backend runs on (Render automatically sets this)
PORT=8081

# Comma-separated list of allowed frontend URLs for CORS
# For local development: http://localhost:5173,http://localhost:5174
# For production: Add your deployed frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend-app.vercel.app

# JWT Secret for signing tokens (Must be at least 64 characters)
# Generate a secure random string for production!
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLXRoaXMtc2VjcmV0LWJlZm9yZS1kZXBsb3ltZW50LTY0Y2hhcnMtbWluaW11bS1wbGVhc2U=

# Token expiration time in milliseconds (86400000 = 1 day)
JWT_EXPIRATION_MS=86400000

# Optional: Stripe API Key for payments
STRIPE_API_KEY=

# --- Production Database Config (Optional, defaults to in-memory H2) ---
# If deploying to production, you should use a real database (MySQL, PostgreSQL)
# DB_URL=jdbc:mysql://your-db-host:3306/bidsphere
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQL8Dialect
