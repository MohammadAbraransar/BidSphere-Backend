# Backend Environment Variables (MySQL Configuration)
# ---------------------------------------------------

# Server Port
PORT=8081

# Allowed Frontend URLs for CORS (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend-app.vercel.app

# MySQL Database Configuration
# Local default: jdbc:mysql://localhost:3306/bidsphere
# Cloud example (Aiven / Railway / Render): jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/bidsphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# JWT Security Configuration
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLXRoaXMtc2VjcmV0LWJlZm9yZS1kZXBsb3ltZW50LTY0Y2hhcnMtbWluaW11bS1wbGVhc2U=
JWT_EXPIRATION_MS=86400000

# Optional Stripe Key
STRIPE_API_KEY=
